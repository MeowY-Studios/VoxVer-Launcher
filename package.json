{
  "name": "voxver-launcher",
  "version": "0.6.4",
  "description": "VoxVer Launcher - 一个现代化的 Minecraft 启动器，支持微软正版登录、版本管理、Mod 下载",
  "main": "./out/main/index.js",
  "author": "EccenTri",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nnkmn/VoxVer-Launcher.git"
  },
  "scripts": {
    "dev": "npm run build && cross-env NODE_ENV=development electron .",
    "dev:hot": "electron-vite dev",
    "dev:web": "vite --config vite.config.web.ts",
    "dev:zh": "chcp 65001 > nul && npm run build && cross-env NODE_ENV=development electron .",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "postbuild": "node scripts/fix-is.js",
    "build:win": "node scripts/build-win.js",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/ electron/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@xmcl/client": "^3.2.0",
    "@xmcl/core": "^2.15.1",
    "@xmcl/curseforge": "^2.2.0",
    "@xmcl/file-transfer": "^2.0.3",
    "@xmcl/forge-site-parser": "^2.0.9",
    "@xmcl/game-data": "^1.2.6",
    "@xmcl/gamesetting": "^3.0.3",
    "@xmcl/installer": "^6.1.2",
    "@xmcl/mod-parser": "^3.4.2",
    "@xmcl/modrinth": "^2.5.0",
    "@xmcl/nbt": "^3.0.2",
    "@xmcl/resourcepack": "^1.2.5",
    "@xmcl/unzip": "^2.1.2",
    "@xmcl/user": "^4.3.0",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "axios": "^1.7.0",
    "better-sqlite3": "^12.0.0",
    "crypto-js": "^4.2.0",
    "electron-log": "^5.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.3",
    "peerjs": "^1.5.5",
    "pinia": "^2.2.0",
    "sharp": "^0.35.3",
    "unzipper": "^0.12.3",
    "vue": "^3.5.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.14.0",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^42.6.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^24.0.0",
    "png-to-ico": "^3.0.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.8.3",
    "sass": "^1.77.0",
    "sass-embedded": "^1.99.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.1",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
